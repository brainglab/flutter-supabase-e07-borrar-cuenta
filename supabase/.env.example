# Cliente OAuth «Aplicación web» de Google Cloud
# (Google Auth Platform → Clients). URL de retorno:
# http://127.0.0.1:54321/auth/v1/callback
# Copia a supabase/.env (en .gitignore). Nunca va en la app.
# Con Android e iOS: WEB_ID,IOS_ID,ANDROID_ID (el web primero).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
